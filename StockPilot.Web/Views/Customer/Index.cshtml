@model List<StockPilot.EntityLayer.Entities.Customer>

@{
    ViewData["Title"] = "Customers";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPageCount ?? 0;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Customers</h2>
            <p class="text-muted mb-0">Manage customer information and status.</p>
        </div>

        @if (Model != null && Model.Any())
        {
            <a asp-controller="Customer" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>
                Add Customer
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-person-vcard fs-1 text-muted"></i>
                <h5 class="mt-3">No customers found</h5>
                <p class="text-muted">Add your first customer to get started.</p>
                <a asp-controller="Customer" asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Add Customer
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Customer List</strong>
                <span class="badge bg-primary rounded-pill">@totalCount Customers</span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Contact</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="product-icon"><i class="bi bi-person-vcard"></i></div>
                                            <strong>@customer.Name</strong>
                                        </div>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(customer.ContactPerson) ? "-" : customer.ContactPerson)</td>
                                    <td>@(string.IsNullOrWhiteSpace(customer.Email) ? "-" : customer.Email)</td>
                                    <td>@(string.IsNullOrWhiteSpace(customer.Phone) ? "-" : customer.Phone)</td>
                                    <td>
                                        @if (customer.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                <i class="bi bi-check-circle me-1"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                <i class="bi bi-dash-circle me-1"></i>Inactive
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-controller="Customer" asp-action="Edit"
                                               asp-route-id="@customer.CustomerId"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </a>

                                            @if (customer.IsActive)
                                            {
                                                <form asp-controller="Customer" asp-action="Deactivate"
                                                      asp-route-id="@customer.CustomerId"
                                                      method="post" class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to deactivate this customer?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-x-circle me-1"></i>Deactivate
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (totalPages > 1)
            {
                <div class="card-footer bg-white py-3">
                    <nav aria-label="Customer pages">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-controller="Customer" asp-action="Index"
                                   asp-route-page="@(currentPage - 1)">
                                    <i class="bi bi-chevron-left me-1"></i>Previous
                                </a>
                            </li>
                            @for (int p = 1; p <= totalPages; p++)
                            {
                                <li class="page-item @(currentPage == p ? "active" : "")">
                                    <a class="page-link" asp-controller="Customer" asp-action="Index"
                                       asp-route-page="@p">@p</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-controller="Customer" asp-action="Index"
                                   asp-route-page="@(currentPage + 1)">
                                    Next<i class="bi bi-chevron-right ms-1"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
</div>