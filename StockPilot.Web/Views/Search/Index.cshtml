@model StockPilot.Web.Models.SearchResultViewModel

@{
    ViewData["Title"] = "Search Results";
}

<div class="container-fluid">
    <div class="mb-4">
        <h3 class="mb-1">Search Results</h3>
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <p class="text-muted mb-0">
                @Model.TotalResultCount result(s) for "<strong>@Model.Query</strong>"
            </p>
        }
    </div>

    @if (string.IsNullOrWhiteSpace(Model.Query))
    {
        <div class="card shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-search d-block mb-3" style="font-size: 48px;"></i>
                Type something in the search box to find products and warehouses.
            </div>
        </div>
    }
    else if (Model.TotalResultCount == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-emoji-frown d-block mb-3" style="font-size: 48px;"></i>
                No results found for "<strong>@Model.Query</strong>".
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">
                            <i class="bi bi-box-seam me-1"></i>
                            Products
                        </span>
                        <span class="badge bg-primary">@Model.Products.Count</span>
                    </div>

                    @if (!Model.Products.Any())
                    {
                        <div class="card-body text-center text-muted py-4">
                            No matching products.
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var product in Model.Products)
                            {
                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@product.ProductId"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@product.Name</div>
                                        <div class="text-muted small">@product.SKU</div>
                                    </div>
                                    @if (!product.IsActive)
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">
                            <i class="bi bi-building me-1"></i>
                            Warehouses
                        </span>
                        <span class="badge bg-primary">@Model.Warehouses.Count</span>
                    </div>

                    @if (!Model.Warehouses.Any())
                    {
                        <div class="card-body text-center text-muted py-4">
                            No matching warehouses.
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var warehouse in Model.Warehouses)
                            {
                                <a asp-controller="Warehouse"
                                   asp-action="Index"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@warehouse.Name</div>
                                        <div class="text-muted small">@warehouse.Location</div>
                                    </div>
                                    @if (!warehouse.IsActive)
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>