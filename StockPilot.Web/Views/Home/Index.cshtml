@model StockPilot.Web.Models.DashboardViewModel
@using StockPilot.EntityLayer.Enums

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="mb-4">
        <h3 class="mb-1">Dashboard</h3>
        <p class="text-muted mb-0">
            Overview of your inventory and recent activity.
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary-subtle p-3 me-3">
                        <i class="bi bi-box-seam text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Products</div>
                        <div class="fs-4 fw-semibold">@Model.TotalProductCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-info-subtle p-3 me-3">
                        <i class="bi bi-building-fill text-info fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Warehouses</div>
                        <div class="fs-4 fw-semibold">@Model.TotalWarehouseCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning-subtle p-3 me-3">
                        <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Critical Stock</div>
                        <div class="fs-4 fw-semibold">@Model.CriticalStockCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success-subtle p-3 me-3">
                        <i class="bi bi-arrow-left-right text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Movements</div>
                        <div class="fs-4 fw-semibold">@Model.TotalMovementCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning-subtle p-3 me-3">
                        <i class="bi bi-cart-plus text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Pending Purchases</div>
                        <div class="fs-4 fw-semibold">@Model.PendingPurchaseOrderCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning-subtle p-3 me-3">
                        <i class="bi bi-send text-warning fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Pending Sales</div>
                        <div class="fs-4 fw-semibold">@Model.PendingSalesOrderCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary-subtle p-3 me-3">
                        <i class="bi bi-box-arrow-in-down text-primary fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Purchases (This Month)</div>
                        <div class="fs-5 fw-semibold">@Model.MonthlyPurchaseTotal.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success-subtle p-3 me-3">
                        <i class="bi bi-box-arrow-up text-success fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Sales (This Month)</div>
                        <div class="fs-5 fw-semibold">@Model.MonthlySalesTotal.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <span class="fw-semibold">
                        <i class="bi bi-pie-chart me-1"></i>
                        Movement Types
                    </span>
                </div>
                <div class="card-body">
                    <canvas id="movementTypeChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <span class="fw-semibold">
                        <i class="bi bi-bar-chart me-1"></i>
                        Stock by Warehouse
                    </span>
                </div>
                <div class="card-body">
                    <canvas id="warehouseStockChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <span class="fw-semibold">
                        <i class="bi bi-graph-up me-1"></i>
                        Movements (Last 7 Days)
                    </span>
                </div>
                <div class="card-body">
                    <canvas id="movementTrendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <span class="fw-semibold">
                        <i class="bi bi-bar-chart-line me-1"></i>
                        Order Overview
                    </span>
                </div>
                <div class="card-body">
                    <canvas id="orderChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <span class="fw-semibold">
                        <i class="bi bi-trophy me-1"></i>
                        Top Selling Products
                    </span>
                </div>
                <div class="card-body">
                    <canvas id="topProductsChart" style="max-height: 280px;"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Critical Stock
                    </span>
                    <a asp-controller="Inventory" asp-action="Index"
                       class="btn btn-sm btn-outline-secondary">
                        View All
                    </a>
                </div>

                @if (!Model.CriticalStocks.Any())
                {
                    <div class="card-body text-center text-muted py-4">
                        No critical stock. Everything looks good.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Warehouse</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Reorder</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stock in Model.CriticalStocks)
                                {
                                    <tr>
                                        <td>
                                            @stock.Product.Name
                                            <span class="text-muted small">(@stock.Product.SKU)</span>
                                        </td>
                                        <td>@stock.Warehouse.Name</td>
                                        <td class="text-end">
                                            @if (stock.Quantity == 0)
                                            {
                                                <span class="badge bg-danger">0</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-white">@stock.Quantity</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">
                        <i class="bi bi-clock-history me-1"></i>
                        Recent Movements
                    </span>
                    <a asp-controller="Inventory" asp-action="MovementHistory"
                       class="btn btn-sm btn-outline-secondary">
                        View All
                    </a>
                </div>

                @if (!Model.RecentMovements.Any())
                {
                    <div class="card-body text-center text-muted py-4">
                        No movements recorded yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Product</th>
                                    <th>Type</th>
                                    <th class="text-end">Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movement in Model.RecentMovements)
                                {
                                    <tr>
                                        <td class="text-muted small">
                                            @movement.MovementDateUtc.ToString("yyyy-MM-dd HH:mm")
                                        </td>
                                        <td>
                                            @if (movement.Product != null)
                                            {
                                                @movement.Product.Name
                                            }
                                        </td>
                                        <td>
                                            @switch (movement.MovementType)
                                            {
                                                case StockMovementType.StockIn:
                                                    <span class="badge bg-success">Stock In</span>
                                                    break;
                                                case StockMovementType.StockOut:
                                                    <span class="badge bg-danger">Stock Out</span>
                                                    break;
                                                case StockMovementType.Transfer:
                                                    <span class="badge bg-primary">Transfer</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end fw-semibold">@movement.Quantity</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        
        new Chart(document.getElementById("movementTypeChart"), {
            type: "doughnut",
            data: {
                labels: ["Stock In", "Stock Out", "Transfer"],
                datasets: [{
                    data: [@Model.StockInCount, @Model.StockOutCount, @Model.TransferCount],
                    backgroundColor: ["#198754", "#dc3545", "#0d6efd"]
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: "bottom" }
                }
            }
        });

        
        new Chart(document.getElementById("warehouseStockChart"), {
            type: "bar",
            data: {
                labels: @Html.Raw(Json.Serialize(Model.WarehouseNames)),
                datasets: [{
                    label: "Total Stock",
                    data: @Html.Raw(Json.Serialize(Model.WarehouseQuantities)),
                    backgroundColor: "#0d6efd"
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });

        
        new Chart(document.getElementById("movementTrendChart"), {
            type: "line",
            data: {
                labels: @Html.Raw(Json.Serialize(Model.MovementDays)),
                datasets: [{
                    label: "Movements",
                    data: @Html.Raw(Json.Serialize(Model.MovementDayCounts)),
                    borderColor: "#0d6efd",
                    backgroundColor: "rgba(13, 110, 253, 0.1)",
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });
                new Chart(document.getElementById("orderChart"), {
            type: "bar",
            data: {
                labels: ["Purchase Orders", "Sales Orders"],
                datasets: [{
                    label: "Total Orders",
                    data: [@Model.PurchaseOrderCount, @Model.SalesOrderCount],
                    backgroundColor: ["#0d6efd", "#198754"]
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
                    new Chart(document.getElementById("topProductsChart"), {
            type: "bar",
            data: {
                labels: @Html.Raw(Json.Serialize(Model.TopProductNames)),
                datasets: [{
                    label: "Units Sold",
                    data: @Html.Raw(Json.Serialize(Model.TopProductQuantities)),
                    backgroundColor: ["#0d6efd", "#198754", "#ffc107", "#dc3545", "#6f42c1"],
                    borderRadius: 6,
                    barThickness: 26
                }]
            },
            options: {
                indexAxis: "y",
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });
    </script>
}