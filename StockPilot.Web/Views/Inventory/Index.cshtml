@model StockPilot.Web.Models.InventoryIndexViewModel

@{
    ViewData["Title"] = "Inventory";

    var selectedWarehouseName = "All Warehouses";

    if (Model.WarehouseId.HasValue)
    {
        var selectedWarehouse = Model.Warehouses.FirstOrDefault(
            warehouse => warehouse.WarehouseId == Model.WarehouseId.Value);

        if (selectedWarehouse != null)
        {
            selectedWarehouseName = selectedWarehouse.Name;
        }
    }
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/inventory.css"
          asp-append-version="true" />
}

<div class="container-fluid">
@if (TempData["SuccessMessage"] != null)
{
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Inventory Management</h3>

            <p class="text-muted mb-0">
                View warehouse-based stock quantities and stock status.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Inventory"
               asp-action="StockIn"
               class="btn btn-outline-primary">
                <i class="bi bi-box-arrow-in-down me-1"></i>
                Stock In
            </a>

            <a asp-controller="Inventory"
               asp-action="StockOut"
               class="btn btn-outline-primary">
                <i class="bi bi-box-arrow-up me-1"></i>
                Stock Out
            </a>

            <a asp-controller="Inventory"
               asp-action="Transfer"
               class="btn btn-outline-primary">
                <i class="bi bi-arrow-left-right me-1"></i>
                Transfer
            </a>

            <a asp-controller="Inventory"
               asp-action="MovementHistory"
               class="btn btn-outline-primary">
                <i class="bi bi-clock-history me-1"></i>
                History
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-controller="Inventory"
                  asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label for="searchTerm" class="form-label">
                        Product Search
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="searchTerm"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Search by product name or SKU..." />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        Warehouse
                    </label>

                    <input type="hidden"
                           id="warehouseId"
                           name="warehouseId"
                           value="@Model.WarehouseId" />

                    <div class="dropdown w-100">
                        <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start warehouse-dropdown-button"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <span id="warehouseDropdownText">
                                @selectedWarehouseName
                            </span>
                        </button>

                        <ul class="dropdown-menu w-100 warehouse-dropdown-menu">
                            <li>
                                <button type="button"
                                        class="dropdown-item warehouse-option"
                                        data-value=""
                                        data-name="All Warehouses">
                                    All Warehouses
                                </button>
                            </li>

                            @foreach (var warehouse in Model.Warehouses)
                            {
                                <li>
                                    <button type="button"
                                            class="dropdown-item warehouse-option"
                                            data-value="@warehouse.WarehouseId"
                                            data-name="@warehouse.Name">
                                        @warehouse.Name
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            <i class="bi bi-funnel me-1"></i>
                            Filter
                        </button>

                        <a asp-controller="Inventory"
                           asp-action="Index"
                           class="btn btn-outline-secondary"
                           title="Reset filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Stocks.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-boxes text-primary empty-inventory-icon"></i>

                <h4 class="mt-3">
                    No inventory records found
                </h4>

                <p class="text-muted mb-0">
                    No stock records match the selected filters.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Inventory List</strong>

                <span class="badge bg-primary rounded-pill">
                    @Model.TotalStockCount Records
                </span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Warehouse</th>
                                <th>Location</th>
                                <th>Quantity</th>
                                <th>Reorder Level</th>
                                <th>Stock Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var stock in Model.Stocks)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="product-icon">
                                                <i class="bi bi-box-seam"></i>
                                            </div>

                                            <strong>
                                                @stock.Product.Name
                                            </strong>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @stock.Product.SKU
                                        </span>
                                    </td>

                                    <td>
                                        <i class="bi bi-building text-muted me-1"></i>
                                        @stock.Warehouse.Name
                                    </td>

                                    <td>
                                        <i class="bi bi-geo-alt text-muted me-1"></i>
                                        @stock.Warehouse.Location
                                    </td>

                                    <td>
                                        <strong>
                                            @stock.Quantity
                                        </strong>
                                    </td>

                                    <td>
                                        @stock.Product.ReorderLevel
                                    </td>

                                    <td>
                                        @if (stock.Quantity == 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">
                                                <i class="bi bi-x-circle me-1"></i>
                                                Out of Stock
                                            </span>
                                        }
                                        else if (stock.Quantity <= stock.Product.ReorderLevel)
                                        {
                                            <span class="badge stock-status-critical">
                                                <i class="bi bi-exclamation-triangle me-1"></i>
                                                Critical
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                In Stock
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (Model.TotalPageCount > 1)
            {
                <div class="card-footer bg-white py-3">
                    <nav aria-label="Inventory pages">
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-controller="Inventory"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-warehouseId="@Model.WarehouseId">
                                    <i class="bi bi-chevron-left me-1"></i>
                                    Previous
                                </a>
                            </li>

                            @for (int pageNumber = 1;
                                                pageNumber <= Model.TotalPageCount;
                                                pageNumber++)
                            {
                                <li class="page-item @(Model.CurrentPage == pageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-controller="Inventory"
                                       asp-action="Index"
                                       asp-route-page="@pageNumber"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-warehouseId="@Model.WarehouseId">
                                        @pageNumber
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage == Model.TotalPageCount ? "disabled" : "")">
                                <a class="page-link"
                                   asp-controller="Inventory"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-warehouseId="@Model.WarehouseId">
                                    Next
                                    <i class="bi bi-chevron-right ms-1"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".warehouse-option").forEach(function (option) {
            option.addEventListener("click", function () {
                const warehouseIdInput =
                    document.getElementById("warehouseId");

                const warehouseDropdownText =
                    document.getElementById("warehouseDropdownText");

                warehouseIdInput.value = this.dataset.value;
                warehouseDropdownText.textContent = this.dataset.name;
            });
        });
    </script>
}