@model StockPilot.BusinessLayer.Models.ImportResult

@{
    ViewData["Title"] = "Import Result";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="mb-0">
                        <i class="bi bi-clipboard-check me-2"></i>
                        Import Result
                    </h3>
                </div>

                <div class="card-body">
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="alert alert-success mb-0 text-center">
                                <div class="fs-3 fw-semibold">@Model.SuccessCount</div>
                                <div>Successfully Imported</div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="alert alert-danger mb-0 text-center">
                                <div class="fs-3 fw-semibold">@Model.FailureCount</div>
                                <div>Failed</div>
                            </div>
                        </div>
                    </div>

                    @if (Model.Errors.Any())
                    {
                        <h5 class="mb-3">Errors</h5>
                        <ul class="list-group mb-4">
                            @foreach (var error in Model.Errors)
                            {
                                <li class="list-group-item list-group-item-danger">
                                    <i class="bi bi-x-circle me-2"></i>
                                    @error
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i>
                            All rows were imported successfully.
                        </div>
                    }

                    <a asp-controller="Product"
                       asp-action="Index"
                       class="btn btn-primary">
                        <i class="bi bi-box-seam me-1"></i>
                        Go to Products
                    </a>

                    <a asp-controller="Product"
                       asp-action="Import"
                       class="btn btn-secondary">
                        Import Another File
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>