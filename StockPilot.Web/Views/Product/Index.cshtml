@model List<StockPilot.EntityLayer.Entities.Product>

@{
    ViewData["Title"] = "Products";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalProductCount = ViewBag.TotalProductCount ?? 0;
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Product Management</h3>
            <p class="text-muted mb-0">
                View and manage all registered products.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Product"
               asp-action="Import"
               class="btn btn-outline-primary">
                <i class="bi bi-file-earmark-arrow-up me-1"></i>
                Import
            </a>

            <a asp-controller="Product"
               asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Add New Product
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-box-seam text-primary"
                   style="font-size: 48px;"></i>

                <h4 class="mt-3">No products found</h4>

                <p class="text-muted">
                    Add your first product to start managing inventory.
                </p>

                <a asp-controller="Product"
                   asp-action="Create"
                   class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>
                    Add First Product
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Product List</strong>

                <span class="badge bg-primary rounded-pill">
                    @totalProductCount Products
                </span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Unit Price</th>
                                <th>Reorder Level</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="product-icon">
                                                <i class="bi bi-box-seam"></i>
                                            </div>

                                            <div>
                                                <strong>@product.Name</strong>

                                                @if (!string.IsNullOrWhiteSpace(product.Description))
                                                {
                                                    <div class="text-muted small">
                                                        @product.Description
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @product.SKU
                                        </span>
                                    </td>

                                    <td>
                                        <strong>
                                            @product.UnitPrice.ToString("N2") ₺
                                        </strong>
                                    </td>

                                    <td>@product.ReorderLevel</td>

                                    <td>
                                        @if (product.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                <i class="bi bi-dash-circle me-1"></i>
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-controller="Product"
                                               asp-action="Edit"
                                               asp-route-id="@product.ProductId"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil-square me-1"></i>
                                                Edit
                                            </a>

                                            @if (product.IsActive)
                                            {
                                                <form asp-controller="Product"
                                                      asp-action="Deactivate"
                                                      asp-route-id="@product.ProductId"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to deactivate this product?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-x-circle me-1"></i>
                                                        Deactivate
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (totalPages > 1)
            {
                <div class="card-footer bg-white py-3">
                    <nav aria-label="Product pages">
                        <ul class="pagination justify-content-center mb-0">

                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage - 1)">
                                    <i class="bi bi-chevron-left me-1"></i>
                                    Previous
                                </a>
                            </li>

                            @for (int pageNumber = 1;
                                                pageNumber <= totalPages;
                                                pageNumber++)
                            {
                                <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-controller="Product"
                                       asp-action="Index"
                                       asp-route-page="@pageNumber">
                                        @pageNumber
                                    </a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-page="@(currentPage + 1)">
                                    Next
                                    <i class="bi bi-chevron-right ms-1"></i>
                                </a>
                            </li>

                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
</div>