@model StockPilot.Web.Models.ProductDetailViewModel
@using StockPilot.EntityLayer.Enums

@{
    ViewData["Title"] = "Product Details";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">@Model.Product.Name</h3>
            <p class="text-muted mb-0">
                SKU: @Model.Product.SKU
                @if (!Model.Product.IsActive)
                {
                    <span class="badge bg-secondary ms-2">Inactive</span>
                }
            </p>
        </div>

        <a asp-controller="Product" asp-action="Index"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Products
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <span class="fw-semibold">
                        <i class="bi bi-info-circle me-1"></i>
                        Product Information
                    </span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="text-muted small">Description</div>
                            <div>@(string.IsNullOrWhiteSpace(Model.Product.Description) ? "-" : Model.Product.Description)</div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="text-muted small">Unit Price</div>
                            <div>@Model.Product.UnitPrice.ToString("N2")</div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="text-muted small">Reorder Level</div>
                            <div>@Model.Product.ReorderLevel</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <div class="text-muted small">Total Stock (All Warehouses)</div>
                    <div class="display-6 fw-semibold">@Model.TotalQuantity</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <span class="fw-semibold">
                        <i class="bi bi-building me-1"></i>
                        Stock by Warehouse
                    </span>
                </div>

                @if (!Model.StockByWarehouse.Any())
                {
                    <div class="card-body text-center text-muted py-4">
                        This product has no stock in any warehouse.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Warehouse</th>
                                    <th class="text-end">Quantity</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var stock in Model.StockByWarehouse)
                                {
                                    <tr>
                                        <td>@stock.Warehouse.Name</td>
                                        <td class="text-end fw-semibold">@stock.Quantity</td>
                                        <td>
                                            @if (stock.Quantity == 0)
                                            {
                                                <span class="badge bg-danger">Out of Stock</span>
                                            }
                                            else if (stock.Quantity <= Model.Product.ReorderLevel)
                                            {
                                                <span class="badge bg-warning text-white">Critical</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">In Stock</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header">
                    <span class="fw-semibold">
                        <i class="bi bi-clock-history me-1"></i>
                        Recent Movements
                    </span>
                </div>

                @if (!Model.RecentMovements.Any())
                {
                    <div class="card-body text-center text-muted py-4">
                        No movements recorded for this product.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Type</th>
                                    <th class="text-end">Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movement in Model.RecentMovements)
                                {
                                    <tr>
                                        <td class="text-muted small">
                                            @movement.MovementDateUtc.ToString("yyyy-MM-dd HH:mm")
                                        </td>
                                        <td>
                                            @switch (movement.MovementType)
                                            {
                                                case StockMovementType.StockIn:
                                                    <span class="badge bg-success">Stock In</span>
                                                    break;
                                                case StockMovementType.StockOut:
                                                    <span class="badge bg-danger">Stock Out</span>
                                                    break;
                                                case StockMovementType.Transfer:
                                                    <span class="badge bg-primary">Transfer</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end fw-semibold">@movement.Quantity</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>