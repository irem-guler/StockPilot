@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StockPilot</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="app-wrapper">

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="bi bi-box-seam-fill"></i>
                </div>

                <div>
                    <h1>StockPilot</h1>
                    <span>Inventory Management</span>
                </div>
            </div>

            <nav class="sidebar-menu">

                <a asp-controller="Assistant"
                   asp-action="Index"
                   class="menu-item @(controller == "Assistant" ? "active" : "")">
                    <i class="bi bi-robot"></i>
                    <span>AI Assistant</span>
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="menu-item @(controller == "Home" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="menu-item @(controller == "Product" ? "active" : "")">
                    <i class="bi bi-box-fill"></i>
                    <span>Products</span>
                </a>

                <a asp-controller="Warehouse"
                   asp-action="Index"
                   class="menu-item @(controller == "Warehouse" ? "active" : "")">
                    <i class="bi bi-building-fill"></i>
                    <span>Warehouses</span>
                </a>

                <a asp-controller="Supplier"
                   asp-action="Index"
                   class="menu-item @(controller == "Supplier" ? "active" : "")">
                    <i class="bi bi-truck"></i>
                    <span>Suppliers</span>
                </a>

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="menu-item @(controller == "Customer" ? "active" : "")">
                    <i class="bi bi-person-vcard"></i>
                    <span>Customers</span>
                </a>

                <a asp-controller="PurchaseOrder"
                   asp-action="Index"
                   class="menu-item @(controller == "PurchaseOrder" ? "active" : "")">
                    <i class="bi bi-cart-plus"></i>
                    <span>Purchase Orders</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Reorder"
                       asp-action="Index"
                       class="menu-item @(controller == "Reorder" ? "active" : "")">
                        <i class="bi bi-lightbulb"></i>
                        <span>Reorder Suggestions</span>
                    </a>
                }

                <a asp-controller="SalesOrder"
                   asp-action="Index"
                   class="menu-item @(controller == "SalesOrder" ? "active" : "")">
                    <i class="bi bi-send"></i>
                    <span>Sales Orders</span>
                </a>

                <a asp-controller="Inventory"
                   asp-action="Index"
                   class="menu-item @(controller == "Inventory" && action == "Index" ? "active" : "")">
                    <i class="bi bi-boxes"></i>
                    <span>Inventory</span>
                </a>

                <a asp-controller="Map"
                   asp-action="Index"
                   class="menu-item @(controller == "Map" ? "active" : "")">
                    <i class="bi bi-geo-alt"></i>
                    <span>Warehouse Map</span>
                </a>

                <a asp-controller="Inventory"
                   asp-action="MovementHistory"
                   class="menu-item @(controller == "Inventory" && action == "MovementHistory" ? "active" : "")">
                    <i class="bi bi-clock-history"></i>
                    <span>Stock Movements</span>
                </a>

                <a asp-controller="Reports"
                   asp-action="Index"
                   class="menu-item @(controller == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart-fill"></i>
                    <span>Reports</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Valuation"
                       asp-action="Index"
                       class="menu-item @(controller == "Valuation" ? "active" : "")">
                        <i class="bi bi-cash-stack"></i>
                        <span>Stock Valuation</span>
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Users"
                       asp-action="Index"
                       class="menu-item @(controller == "Users" ? "active" : "")">
                        <i class="bi bi-people-fill"></i>
                        <span>Users</span>
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <i class="bi bi-database-check"></i>

                <div>
                    <strong>System Status</strong>
                    <span>Database connected</span>
                </div>
            </div>
        </aside>

        <!-- Main area -->
        <div class="main-area">

            <!-- Topbar -->
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle"
                            id="sidebarToggle"
                            type="button">
                        <i class="bi bi-list"></i>
                    </button>

                    <div>
                        <h2>@ViewData["Title"]</h2>
                        <span>Manage your inventory efficiently</span>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Search"
                          asp-action="Index"
                          method="get"
                          class="topbar-search">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text"
                                   name="query"
                                   class="form-control border-start-0"
                                   placeholder="Search products, warehouses..."
                                   value="@Context.Request.Query["query"]" />
                        </div>
                    </form>
                }

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-area">

                        <button type="button" id="themeToggle" class="theme-toggle me-2" title="Toggle theme">
                            <i class="bi bi-moon-stars"></i>
                        </button>

                        <div class="user-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div class="user-information">
                            <strong>@User.Identity.Name</strong>

                            <span>
                                @(User.IsInRole("Admin") ? "Administrator" : "User")
                            </span>
                        </div>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="ms-3 mb-0">

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    title="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                }
            </header>

            <!-- Page content -->
            <main class="page-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© 2026 StockPilot</span>
                <span>Inventory Management System</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebarToggle = document.getElementById("sidebarToggle");
        const sidebar = document.getElementById("sidebar");
        const mainArea = document.querySelector(".main-area");
        const toggleIcon = sidebarToggle.querySelector("i");

        function updateToggleIcon() {
            if (window.innerWidth <= 900) {
                toggleIcon.className = "bi bi-list";
                return;
            }

            toggleIcon.className = sidebar.classList.contains("collapsed")
                ? "bi bi-chevron-right"
                : "bi bi-chevron-left";
        }

        function applySidebarState() {
            if (window.innerWidth <= 900) {
                sidebar.classList.remove("collapsed");
                mainArea.classList.remove("sidebar-collapsed");
            } else {
                const isCollapsed =
                    localStorage.getItem("stockPilotSidebarCollapsed") === "true";

                sidebar.classList.toggle("collapsed", isCollapsed);
                mainArea.classList.toggle("sidebar-collapsed", isCollapsed);
                sidebar.classList.remove("show");
            }

            updateToggleIcon();
        }

        sidebarToggle.addEventListener("click", function () {
            if (window.innerWidth <= 900) {
                sidebar.classList.toggle("show");
            } else {
                const isCollapsed = sidebar.classList.toggle("collapsed");

                mainArea.classList.toggle("sidebar-collapsed", isCollapsed);

                localStorage.setItem(
                    "stockPilotSidebarCollapsed",
                    isCollapsed
                );
            }

            updateToggleIcon();
        });

        window.addEventListener("resize", applySidebarState);

        applySidebarState();
    </script>

    <script>
        (function () {
            const body = document.body;
            const toggle = document.getElementById("themeToggle");

            // Sayfa yüklenince kayıtlı tercihi uygula
            const savedTheme = localStorage.getItem("stockpilot-theme");
            if (savedTheme === "dark") {
                body.classList.add("dark-mode");
                updateIcon(true);
            }

            function updateIcon(isDark) {
                if (!toggle) return;
                const icon = toggle.querySelector("i");
                if (!icon) return;
                icon.className = isDark ? "bi bi-sun-fill" : "bi bi-moon-stars";
            }

            if (toggle) {
                toggle.addEventListener("click", function () {
                    const isDark = body.classList.toggle("dark-mode");
                    localStorage.setItem("stockpilot-theme", isDark ? "dark" : "light");
                    updateIcon(isDark);
                });
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <div id="assistantBubble" class="assistant-bubble">
        <i class="bi bi-robot"></i>
    </div>

    <div id="assistantPanel" class="assistant-panel">
        <div class="assistant-panel-header">
            <span><i class="bi bi-robot me-2"></i>AI Assistant</span>
            <button type="button" id="assistantClose" class="assistant-close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div id="bubbleChatWindow" class="assistant-panel-body">
            <div class="assistant-msg-bubble">
                Hi! Ask me anything about your inventory.
            </div>
        </div>
        <div class="assistant-panel-input">
            <input type="text" id="bubbleInput" class="form-control form-control-sm"
                   placeholder="Type a question..." autocomplete="off" />
            <button id="bubbleSend" class="btn btn-primary btn-sm">
                <i class="bi bi-send"></i>
            </button>
        </div>
    </div>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        @Html.AntiForgeryToken()
    }

    <style>
        .assistant-bubble {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 56px;
            height: 56px;
            background-color: #2563eb;
            color: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 4px 16px rgba(0,0,0,0.25);
            z-index: 1050;
            transition: transform 0.15s;
        }

            .assistant-bubble:hover {
                transform: scale(1.08);
            }

        .assistant-panel {
            position: fixed;
            bottom: 92px;
            right: 24px;
            width: 360px;
            max-width: calc(100vw - 48px);
            height: 480px;
            background-color: #fff;
            border-radius: 14px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.28);
            display: none;
            flex-direction: column;
            overflow: hidden;
            z-index: 1050;
        }

            .assistant-panel.open {
                display: flex;
            }

        .assistant-panel-header {
            background-color: #2563eb;
            color: #fff;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-weight: 600;
        }

        .assistant-close {
            background: none;
            border: none;
            color: #fff;
            cursor: pointer;
            font-size: 16px;
        }

        .assistant-panel-body {
            flex: 1;
            overflow-y: auto;
            padding: 14px;
            background-color: #f8fafc;
        }

        .user-msg-bubble, .assistant-msg-bubble {
            max-width: 85%;
            padding: 8px 12px;
            border-radius: 10px;
            margin-bottom: 8px;
            line-height: 1.45;
            font-size: 14px;
            white-space: pre-wrap;
        }

        .user-msg-bubble {
            background-color: #2563eb;
            color: #fff;
            margin-left: auto;
            border-bottom-right-radius: 3px;
        }

        .assistant-msg-bubble {
            background-color: #e9edf2;
            color: #1f2937;
            margin-right: auto;
            border-bottom-left-radius: 3px;
        }

        .assistant-panel-input {
            display: flex;
            gap: 6px;
            padding: 10px;
            border-top: 1px solid #e5e7eb;
            background-color: #fff;
        }

        body.dark-mode .assistant-panel {
            background-color: #1c1f24;
        }

        body.dark-mode .assistant-panel-body {
            background-color: #16181c;
        }

        body.dark-mode .assistant-msg-bubble {
            background-color: #23272e;
            color: #e5e7eb;
        }

        body.dark-mode .assistant-panel-input {
            background-color: #1c1f24;
            border-color: #2a2e35;
        }
    </style>

    <script>
        (function () {
            const bubble = document.getElementById("assistantBubble");
            const panel = document.getElementById("assistantPanel");
            const closeBtn = document.getElementById("assistantClose");
            const chatWindow = document.getElementById("bubbleChatWindow");
            const input = document.getElementById("bubbleInput");
            const sendBtn = document.getElementById("bubbleSend");
            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');

            if (!bubble || !tokenEl) return;
            const token = tokenEl.value;

            bubble.addEventListener("click", function () {
                panel.classList.toggle("open");
                if (panel.classList.contains("open")) input.focus();
            });
            closeBtn.addEventListener("click", function () {
                panel.classList.remove("open");
            });

            function addMsg(text, isUser) {
                const div = document.createElement("div");
                div.className = isUser ? "user-msg-bubble" : "assistant-msg-bubble";
                div.textContent = text;
                chatWindow.appendChild(div);
                chatWindow.scrollTop = chatWindow.scrollHeight;
                return div;
            }

            async function send() {
                const q = input.value.trim();
                if (!q) return;
                addMsg(q, true);
                input.value = "";
                sendBtn.disabled = true;
                const typing = addMsg("Thinking...", false);
                typing.style.fontStyle = "italic";
                typing.style.opacity = "0.7";

                try {
                    const res = await fetch("/Assistant/Ask", {
                        method: "POST",
                        headers: { "Content-Type": "application/json", "RequestVerificationToken": token },
                        body: JSON.stringify({ question: q })
                    });
                    const data = await res.json();
                    typing.remove();
                    addMsg(data.answer, false);
                } catch (e) {
                    typing.remove();
                    addMsg("Sorry, something went wrong.", false);
                } finally {
                    sendBtn.disabled = false;
                    input.focus();
                }
            }

            sendBtn.addEventListener("click", send);
            input.addEventListener("keypress", function (e) {
                if (e.key === "Enter") send();
            });
        })();
    </script>

</body>

</html>
