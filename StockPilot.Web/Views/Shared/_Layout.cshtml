@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StockPilot</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="app-wrapper">

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="bi bi-box-seam-fill"></i>
                </div>

                <div>
                    <h1>StockPilot</h1>
                    <span>Inventory Management</span>
                </div>
            </div>

            <nav class="sidebar-menu">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="menu-item @(controller == "Home" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>
                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="menu-item @(controller == "Product" ? "active" : "")">
                    <i class="bi bi-box-fill"></i>
                    <span>Products</span>
                </a>

                <a asp-controller="Warehouse"
                   asp-action="Index"
                   class="menu-item @(controller == "Warehouse" ? "active" : "")">
                    <i class="bi bi-building-fill"></i>
                    <span>Warehouses</span>
                </a>

                <a asp-controller="Supplier"
                   asp-action="Index"
                   class="menu-item @(controller == "Supplier" ? "active" : "")">
                    <i class="bi bi-truck"></i>
                    <span>Suppliers</span>
                </a>

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="menu-item @(controller == "Customer" ? "active" : "")">
                    <i class="bi bi-person-vcard"></i>
                    <span>Customers</span>
                </a>

                <a asp-controller="PurchaseOrder"
                   asp-action="Index"
                   class="menu-item @(controller == "PurchaseOrder" ? "active" : "")">
                    <i class="bi bi-cart-plus"></i>
                    <span>Purchase Orders</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Reorder"
                       asp-action="Index"
                       class="menu-item @(controller == "Reorder" ? "active" : "")">
                        <i class="bi bi-lightbulb"></i>
                        <span>Reorder Suggestions</span>
                    </a>
                }

                <a asp-controller="SalesOrder"
                   asp-action="Index"
                   class="menu-item @(controller == "SalesOrder" ? "active" : "")">
                    <i class="bi bi-send"></i>
                    <span>Sales Orders</span>
                </a>

                <a asp-controller="Inventory"
                   asp-action="Index"
                   class="menu-item @(controller == "Inventory" && action == "Index" ? "active" : "")">
                    <i class="bi bi-boxes"></i>
                    <span>Inventory</span>
                </a>

                <a asp-controller="Map"
                   asp-action="Index"
                   class="menu-item @(controller == "Map" ? "active" : "")">
                    <i class="bi bi-geo-alt"></i>
                    <span>Warehouse Map</span>
                </a>

                <a asp-controller="Inventory"
                   asp-action="MovementHistory"
                   class="menu-item @(controller == "Inventory" && action == "MovementHistory" ? "active" : "")">
                    <i class="bi bi-clock-history"></i>
                    <span>Stock Movements</span>
                </a>

                <a asp-controller="Reports"
                   asp-action="Index"
                   class="menu-item @(controller == "Reports" ? "active" : "")">
                    <i class="bi bi-bar-chart-fill"></i>
                    <span>Reports</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Valuation"
                       asp-action="Index"
                       class="menu-item @(controller == "Valuation" ? "active" : "")">
                        <i class="bi bi-cash-stack"></i>
                        <span>Stock Valuation</span>
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Users"
                       asp-action="Index"
                       class="menu-item @(controller == "Users" ? "active" : "")">
                        <i class="bi bi-people-fill"></i>
                        <span>Users</span>
                    </a>
                }
            </nav>

            <div class="sidebar-footer">
                <i class="bi bi-database-check"></i>

                <div>
                    <strong>System Status</strong>
                    <span>Database connected</span>
                </div>
            </div>
        </aside>

        <!-- Main area -->
        <div class="main-area">

            <!-- Topbar -->
            <header class="topbar">
                <div class="topbar-left">
                    <button class="sidebar-toggle"
                            id="sidebarToggle"
                            type="button">
                        <i class="bi bi-list"></i>
                    </button>

                    <div>
                        <h2>@ViewData["Title"]</h2>
                        <span>Manage your inventory efficiently</span>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Search"
                          asp-action="Index"
                          method="get"
                          class="topbar-search">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text"
                                   name="query"
                                   class="form-control border-start-0"
                                   placeholder="Search products, warehouses..."
                                   value="@Context.Request.Query["query"]" />
                        </div>
                    </form>
                }

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="user-area">

                        <button type="button" id="themeToggle" class="theme-toggle me-2" title="Toggle theme">
                            <i class="bi bi-moon-stars"></i>
                        </button>

                        <div class="user-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div class="user-information">
                            <strong>@User.Identity.Name</strong>

                            <span>
                                @(User.IsInRole("Admin") ? "Administrator" : "User")
                            </span>
                        </div>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="ms-3 mb-0">

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    title="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                }
            </header>

            <!-- Page content -->
            <main class="page-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>© 2026 StockPilot</span>
                <span>Inventory Management System</span>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebarToggle = document.getElementById("sidebarToggle");
        const sidebar = document.getElementById("sidebar");
        const mainArea = document.querySelector(".main-area");
        const toggleIcon = sidebarToggle.querySelector("i");

        function updateToggleIcon() {
            if (window.innerWidth <= 900) {
                toggleIcon.className = "bi bi-list";
                return;
            }

            toggleIcon.className = sidebar.classList.contains("collapsed")
                ? "bi bi-chevron-right"
                : "bi bi-chevron-left";
        }

        function applySidebarState() {
            if (window.innerWidth <= 900) {
                sidebar.classList.remove("collapsed");
                mainArea.classList.remove("sidebar-collapsed");
            } else {
                const isCollapsed =
                    localStorage.getItem("stockPilotSidebarCollapsed") === "true";

                sidebar.classList.toggle("collapsed", isCollapsed);
                mainArea.classList.toggle("sidebar-collapsed", isCollapsed);
                sidebar.classList.remove("show");
            }

            updateToggleIcon();
        }

        sidebarToggle.addEventListener("click", function () {
            if (window.innerWidth <= 900) {
                sidebar.classList.toggle("show");
            } else {
                const isCollapsed = sidebar.classList.toggle("collapsed");

                mainArea.classList.toggle("sidebar-collapsed", isCollapsed);

                localStorage.setItem(
                    "stockPilotSidebarCollapsed",
                    isCollapsed
                );
            }

            updateToggleIcon();
        });

        window.addEventListener("resize", applySidebarState);

        applySidebarState();
    </script>

    <script>
        (function () {
            const body = document.body;
            const toggle = document.getElementById("themeToggle");

            // Sayfa yüklenince kayıtlı tercihi uygula
            const savedTheme = localStorage.getItem("stockpilot-theme");
            if (savedTheme === "dark") {
                body.classList.add("dark-mode");
                updateIcon(true);
            }

            function updateIcon(isDark) {
                if (!toggle) return;
                const icon = toggle.querySelector("i");
                if (!icon) return;
                icon.className = isDark ? "bi bi-sun-fill" : "bi bi-moon-stars";
            }

            if (toggle) {
                toggle.addEventListener("click", function () {
                    const isDark = body.classList.toggle("dark-mode");
                    localStorage.setItem("stockpilot-theme", isDark ? "dark" : "light");
                    updateIcon(isDark);
                });
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
