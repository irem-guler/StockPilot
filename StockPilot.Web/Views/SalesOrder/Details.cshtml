@model StockPilot.EntityLayer.Entities.SalesOrder
@using StockPilot.EntityLayer.Enums

@{
    ViewData["Title"] = "Sales Order Details";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Sales Order #@Model.SalesOrderId</h2>
            <p class="text-muted mb-0">Order details and items.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="SalesOrder" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Orders
            </a>
            <a asp-controller="SalesOrder" asp-action="DownloadPdf" asp-route-id="@Model.SalesOrderId"
               class="btn btn-outline-danger" target="_blank">
                <i class="bi bi-file-earmark-pdf me-1"></i>Download PDF
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Order Information</strong></div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="text-muted small">Customer</div>
                            <div>@Model.Customer?.Name</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="text-muted small">Source Warehouse</div>
                            <div>@Model.Warehouse?.Name</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="text-muted small">Order Date</div>
                            <div>@Model.OrderDateUtc.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="text-muted small">Shipped Date</div>
                            <div>@(Model.ShippedDateUtc.HasValue? Model.ShippedDateUtc.Value.ToString("yyyy-MM-dd HH:mm") : "-")</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="text-muted small">Created By</div>
                            <div>@(Model.CreatedByUser != null ? $"{Model.CreatedByUser.FirstName} {Model.CreatedByUser.LastName}".Trim() : "-")</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="text-muted small">Note</div>
                            <div>@(string.IsNullOrWhiteSpace(Model.Note) ? "-" : Model.Note)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <div class="text-muted small mb-2">Status</div>
                    <div class="mb-3">
                        @switch (Model.Status)
                        {
                            case SalesOrderStatus.Pending:
                                <span class="badge bg-warning text-dark fs-6">Pending</span>
                                break;
                            case SalesOrderStatus.Shipped:
                                <span class="badge bg-success fs-6">Shipped</span>
                                break;
                            case SalesOrderStatus.Cancelled:
                                <span class="badge bg-secondary fs-6">Cancelled</span>
                                break;
                        }
                    </div>
                    <div class="text-muted small">Total Amount</div>
                    <div class="display-6 fw-semibold">@Model.TotalAmount.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header"><strong>Order Items</strong></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    @item.Product?.Name
                                    <span class="text-muted small">(@item.Product?.SKU)</span>
                                </td>
                                <td class="text-end">@item.Quantity</td>
                                <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-semibold">@((item.Quantity * item.UnitPrice).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.Status == SalesOrderStatus.Pending)
        {
            <div class="card-footer bg-white d-flex justify-content-end gap-2">
                <form asp-controller="SalesOrder" asp-action="Cancel"
                      asp-route-id="@Model.SalesOrderId" method="post"
                      onsubmit="return confirm('Cancel this order?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-x-circle me-1"></i>Cancel Order
                    </button>
                </form>

                <form asp-controller="SalesOrder" asp-action="Ship"
                      asp-route-id="@Model.SalesOrderId" method="post"
                      onsubmit="return confirm('Ship this order? Stock will be reduced.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-box-arrow-up me-1"></i>Ship Order
                    </button>
                </form>
            </div>
        }
    </div>
</div>