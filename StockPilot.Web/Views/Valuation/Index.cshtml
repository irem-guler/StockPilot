@model StockPilot.Web.Models.ValuationViewModel

@{
    ViewData["Title"] = "Stock Valuation & ABC Analysis";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2 class="mb-1">Stock Valuation & ABC Analysis</h2>
        <p class="text-muted mb-0">
            Financial overview of your inventory, classified by value.
        </p>
    </div>

    <!-- Özet kartlar -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted small">Total Inventory Value</div>
                    <div class="display-6 fw-semibold">@Model.TotalInventoryValue.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted small">Total Products</div>
                    <div class="display-6 fw-semibold">@Model.TotalProductCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted small">Total Units in Stock</div>
                    <div class="display-6 fw-semibold">@Model.TotalUnits</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ABC sınıf özeti + grafik -->
    <div class="row g-3 mb-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>ABC Class Distribution</strong></div>
                <div class="card-body">
                    <canvas id="abcChart" style="max-height: 260px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header"><strong>Class Breakdown</strong></div>
                <div class="card-body">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Class</th>
                                <th class="text-end">Products</th>
                                <th class="text-end">Value</th>
                                <th class="text-end">Share</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="badge bg-danger">A</span> High value</td>
                                <td class="text-end">@Model.ClassACount</td>
                                <td class="text-end">@Model.ClassAValue.ToString("N2")</td>
                                <td class="text-end">
                                    @(Model.TotalInventoryValue > 0 ? Math.Round((double)(Model.ClassAValue / Model.TotalInventoryValue) * 100, 1) : 0)%
                                </td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-warning text-dark">B</span> Medium value</td>
                                <td class="text-end">@Model.ClassBCount</td>
                                <td class="text-end">@Model.ClassBValue.ToString("N2")</td>
                                <td class="text-end">
                                    @(Model.TotalInventoryValue > 0 ? Math.Round((double)(Model.ClassBValue / Model.TotalInventoryValue) * 100, 1) : 0)%
                                </td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-success">C</span> Low value</td>
                                <td class="text-end">@Model.ClassCCount</td>
                                <td class="text-end">@Model.ClassCValue.ToString("N2")</td>
                                <td class="text-end">
                                    @(Model.TotalInventoryValue > 0 ? Math.Round((double)(Model.ClassCValue / Model.TotalInventoryValue) * 100, 1) : 0)%
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="text-muted small mt-3 mb-0">
                        A items make up most of your inventory value and deserve the most attention.
                        C items are many but represent little value.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Ürün değerleme tablosu -->
    <div class="card shadow-sm mb-4">
        <div class="card-header"><strong>Products by Value</strong></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Product</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Total Value</th>
                            <th class="text-end">Share</th>
                            <th class="text-end">Cumulative</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    @if (item.AbcClass == "A")
                                    {
                                        <span class="badge bg-danger">A</span>
                                    }
                                    else if (item.AbcClass == "B")
                                    {
                                        <span class="badge bg-warning text-dark">B</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">C</span>
                                    }
                                </td>
                                <td>
                                    <strong>@item.ProductName</strong>
                                    <span class="text-muted small">(@item.SKU)</span>
                                </td>
                                <td class="text-end">@item.TotalQuantity</td>
                                <td class="text-end">@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-semibold">@item.TotalValue.ToString("N2")</td>
                                <td class="text-end">@item.ValuePercentage%</td>
                                <td class="text-end text-muted">@item.CumulativePercentage%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Ölü stok -->
    <div class="card shadow-sm">
        <div class="card-header">
            <span class="fw-semibold">
                <i class="bi bi-hourglass-bottom me-1"></i>
                Dead Stock (no movement in 30+ days)
            </span>
        </div>
        @if (Model.DeadStock == null || !Model.DeadStock.Any())
        {
            <div class="card-body text-center text-muted py-4">
                No dead stock. All products have recent activity.
            </div>
        }
        else
        {
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Tied-up Value</th>
                                <th>Last Movement</th>
                                <th class="text-end">Days Idle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.DeadStock)
                            {
                                <tr>
                                    <td>
                                        <strong>@d.ProductName</strong>
                                        <span class="text-muted small">(@d.SKU)</span>
                                    </td>
                                    <td class="text-end">@d.TotalQuantity</td>
                                    <td class="text-end fw-semibold">@d.TotalValue.ToString("N2")</td>
                                    <td>
                                        @if (d.LastMovementDate.HasValue)
                                        {
                                            @d.LastMovementDate.Value.ToString("yyyy-MM-dd")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (d.DaysSinceLastMovement < 0)
                                        {
                                            <span class="badge bg-secondary">Never moved</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@d.DaysSinceLastMovement days</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById("abcChart"), {
            type: "doughnut",
            data: {
                labels: ["A (High)", "B (Medium)", "C (Low)"],
                datasets: [{
                    data: [
                        @Model.ClassAValue.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @Model.ClassBValue.ToString(System.Globalization.CultureInfo.InvariantCulture),
                        @Model.ClassCValue.ToString(System.Globalization.CultureInfo.InvariantCulture)
                    ],
                    backgroundColor: ["#dc3545", "#ffc107", "#198754"]
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: "bottom" } }
            }
        });
    </script>
}